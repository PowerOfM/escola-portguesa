---
import home from "../data/home.json";
import { enrollment, enrollmentCopy } from "../utils/enrollment";
---

<section class="home-cta">
  <div class="home-cta-bg">
    <img src="/assets/images/cta-bg2.jpeg" alt="" />
  </div>
  <div class="home-cta-content">
    <h2 set:html={home.cta.heading} />
    <p>{enrollmentCopy(home.cta.body)}</p>
    <a href="/contact" class="btn-primary">
      {enrollment.status === "open" && "REGISTER NOW"}
      {enrollment.status === "waitlist" && "JOIN WAITLIST"}
      {enrollment.status === "closed" && "CONTACT US"}
    </a>
  </div>
</section>
