---
import Layout from "../layouts/Layout.astro";
import CTA from "../components/CTA.astro";
import site from "../data/site.json";

const curriculumModules = import.meta.glob("../data/curriculum/*.md", {
  eager: true,
});
const curriculum = Object.entries(curriculumModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]: [string, any]) => ({
    slug: path.split("/").pop()!.replace(".md", ""),
    ...mod.frontmatter,
    compiledContent: mod.compiledContent,
  }));

const separatorModules = import.meta.glob(
  "../../public/assets/separators/*.{jpeg,jpg,png,webp}",
);
const separatorUrls = Object.keys(separatorModules).map((k) =>
  k.replace(/^.*\/public/, ""),
);
---

<Layout
  title="Children's Classes"
  css="curriculum"
  heroImage="/assets/images/curriculum-hero.jpeg"
  navPage="children"
>
  <section class="curriculum-levels">
    <div class="container">
      {
        curriculum.map((level, i) => (
          <>
            <div class="curriculum-detail" id={level.slug}>
              <div class="curriculum-detail-header">
                <div>
                  <h2>{level.title}</h2>
                </div>
              </div>
              <div
                class="curriculum-detail-body"
                set:html={level.compiledContent()}
              />
            </div>
            {separatorUrls.length > 0 && i < curriculum.length - 1 && (
              <div class="curriculum-collage">
                {[0, 1, 2, 3].map((j) => (
                  <img
                    src={separatorUrls[(i * 4 + j) % separatorUrls.length]}
                    alt=""
                  />
                ))}
              </div>
            )}
          </>
        ))
      }
    </div>
  </section>

  <section class="curriculum-intro">
    <div class="container">
      <div class="curriculum-features">
        <div class="info-card">
          <div class="info-card-header">
            <h3>Proficiency Certification</h3>
          </div>
          <p>
            The Camões Institute (Embassy of Portugal) in Canada uses QuaREPE to
            align language proficiency levels with competence blocks, enabling
            certification of proficiency in Portuguese.
          </p>
        </div>
        <div class="info-card">
          <div class="info-card-header">
            <h3>Heritage Language Teaching</h3>
          </div>
          <p>
            QuaREPE serves as a reference for teaching Portuguese to heritage
            learners in Canadian cities, aiding in curriculum development.
          </p>
        </div>
        <div class="info-card">
          <div class="info-card-header">
            <h3>Framework Alignment</h3>
          </div>
          <p>
            While sometimes linked with the Common European Framework of
            Reference for Languages (CEFR), QuaREPE is specifically focused on
            the teaching of Portuguese abroad.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="curriculum-fees">
    <div class="container curriculum-fees-grid">
      <div class="curriculum-fees-image">
        <img
          src="/assets/images/fees-classroom.jpeg"
          alt="Students in classroom"
        />
      </div>
      <div class="curriculum-fees-content">
        <h2>School Fees</h2>

        <div class="fees-pricing-cards">
          <div class="fees-pricing-card">
            <span class="fees-pricing-label">1 Child</span>
            <div class="fees-pricing-amount">$500</div>
            <span class="fees-pricing-period">per year</span>
          </div>
          <div class="fees-pricing-card fees-pricing-card--featured">
            <span class="fees-pricing-label">2 Siblings</span>
            <div class="fees-pricing-amount">$850</div>
            <span class="fees-pricing-period">per year</span>
          </div>
          <div class="fees-pricing-card">
            <span class="fees-pricing-label">3 Siblings</span>
            <div class="fees-pricing-amount">$1,000</div>
            <span class="fees-pricing-period">per year</span>
          </div>
        </div>

        <div class="curriculum-fees-payment">
          <p>
            Families may choose to pay tuition in one full payment or in two
            installments.
          </p>
          <div class="fees-payment-option">
            <h4>1. One Full Payment</h4>
            <ul class="fees-payment-list">
              <li>
                <strong>E-transfer</strong> &ndash; due November 30 to {
                  site.email.payments
                }
              </li>
              <li><strong>Cheque</strong> &ndash; due November 30</li>
              <li><strong>Cash</strong> &ndash; due November 30</li>
            </ul>
          </div>
          <div class="fees-payment-option">
            <h4>2. Two Installments</h4>
            <ul class="fees-payment-list">
              <li>
                <strong>E-transfer</strong> &ndash; 1st installment due November 30
                / 2nd installment due January 31 to {site.email.payments}
              </li>
              <li>
                <strong>Post-dated cheques</strong> &ndash; 1st dated November 30
                / 2nd dated January 31
              </li>
              <li>
                <strong>Cash</strong> &ndash; 1st due November 30 / 2nd due January
                31
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CTA />
</Layout>
