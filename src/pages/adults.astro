---
import Layout from "../layouts/Layout.astro";
import adults from "../data/adults.json";
---

<Layout
  title="Adults Classes"
  css={["about", "curriculum", "contact"]}
  heroImage="/assets/images/hero-bg2.jpeg"
  navPage="adults"
>
  <section class="two-column">
    <div class="container two-column-grid">
      <div class="two-column-image">
        <img
          src="/assets/images/our-school.jpeg"
          alt="Adults learning Portuguese"
        />
      </div>
      <div class="two-column-content">
        <p class="lead" set:html={adults.intro.lead} />
        {adults.intro.body.map((paragraph: string) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section style="padding-bottom: 80px">
    <div class="container">
      <h2 style="text-align: center; margin-bottom: 1.5rem;">{adults.whatToExpect.heading}</h2>
      <div class="curriculum-features">
        {
          adults.whatToExpect.cards.map((card, i) => (
            <div class="info-card">
              <div class="info-card-header">
                <h3>{card.title}</h3>
                <div class={`info-card-icon info-card-icon--${card.iconColor}`}>
                  {i === 0 && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00A63E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                      <circle cx="9" cy="7" r="4"></circle>
                      <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                      <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                  )}
                  {i === 1 && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#155DFC" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect>
                      <line x1="16" x2="16" y1="2" y2="6"></line>
                      <line x1="8" x2="8" y1="2" y2="6"></line>
                      <line x1="3" x2="21" y1="10" y2="10"></line>
                    </svg>
                  )}
                  {i === 2 && (
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#D08700" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    </svg>
                  )}
                </div>
              </div>
              <p>{card.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="contact-form-section section-tinted">
    <div class="container">
      <h2>{adults.waitlist.heading}</h2>
      <p class="contact-form-intro">{adults.waitlist.intro}</p>

      <form class="contact-form" action="#" method="post">
        <div class="contact-form-row">
          <div class="contact-form-group">
            <label for="name" class="contact-form-label">{adults.waitlist.form.nameLabel}</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder={adults.waitlist.form.namePlaceholder}
              required
            />
          </div>
          <div class="contact-form-group">
            <label for="email" class="contact-form-label">{adults.waitlist.form.emailLabel}</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder={adults.waitlist.form.emailPlaceholder}
              required
            />
          </div>
        </div>

        <div class="contact-form-group">
          <label for="message" class="contact-form-label">{adults.waitlist.form.messageLabel}</label>
          <textarea
            id="message"
            name="message"
            rows={4}
            placeholder={adults.waitlist.form.messagePlaceholder}
          ></textarea>
        </div>

        <div class="contact-form-actions">
          <button type="submit" class="btn-primary">{adults.waitlist.form.submitButton}</button>
          <p class="contact-form-note">{adults.waitlist.form.note}</p>
        </div>
      </form>
    </div>
  </section>
</Layout>
